# Copy this file to .env on the Debian server. Do not commit .env.
# URL used in Bark notifications. It must be reachable by the notification recipient.
SNAPSHOT_URL=http://debian-hostname-or-ip:25852/parking/parking_snapshot.jpg

# Port published by the snapshot-web container. Change it if 25852 is occupied.
SNAPSHOT_HTTP_PORT=25852

# Camera connection string. URL-encode special characters in usernames/passwords.
RTSP_URL=rtsp://camera-user:camera-password@camera-ip:554/Streaming/Channels/102

# Comma-separated Bark device keys, without spaces.
BARK_KEYS=first-bark-key,second-bark-key
